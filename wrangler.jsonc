{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app10",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "34297d82-5abf-421c-905d-4c20f27941e8","database_name": "Jomanji" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "ae938db4e79547c3b36aaa128477d384" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
